DATABASE_URL=
# Set the database connection in the environment for this deployment.
# Leave empty when operational data is in Supabase app_state.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="ordens-servico-fotos"
CHECKLIST_MAX_PHOTO_BYTES="20971520"
JWT_SECRET="troque-por-um-segredo-longo-com-pelo-menos-24-caracteres"
APP_URL="http://localhost:3000"
NODE_ENV="development"
SESSION_MAX_AGE_DAYS="7"
UPLOAD_PROVIDER="supabase"

# Only for local backup / restore commands; never expose in client variables.
BACKUP_ENCRYPTION_KEY=
# Assistente WhatsApp: valores secretos ficam somente no servidor.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-6.2-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Numero do bot com DDI e DDD, somente digitos.
WHATSAPP_BUSINESS_NUMBER=
# Versao habilitada no aplicativo Meta, no formato vNN.N.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_WORKER_SECRET=
WHATSAPP_STORAGE_BUCKET=assistente-privado
# supabase: private bucket; local: persistent disk at .private/whatsapp (not Vercel).
WHATSAPP_STORAGE_DRIVER=supabase

# Web Push do Aliança Campo. Chaves privadas e CRON_SECRET somente no servidor.
FIELD_VAPID_PUBLIC_KEY=
FIELD_VAPID_PRIVATE_KEY=
FIELD_VAPID_SUBJECT=
CRON_SECRET=
# Hora local de São Paulo: andamento, materiais, atualização, encerramento.
FIELD_REMINDER_HOURS=9,12,15,16
