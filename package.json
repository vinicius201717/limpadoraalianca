{
  "name": "floor-restoration-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "whatsapp:worker": "node scripts/whatsapp-worker.mjs",
    "whatsapp:test-gateway": "node --env-file=.env.local scripts/whatsapp-test-gateway.mjs",
    "dev": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next dev",
    "build": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next build",
    "start": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "smoke:roles": "node scripts/smoke-roles.mjs",
    "smoke:checklist": "node scripts/smoke-checklist.mjs",
    "smoke:simulation": "node scripts/smoke-simulation.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:inspect": "node --conditions=react-server --import tsx scripts/operational-db.ts inspect",
    "db:backup": "node --conditions=react-server --import tsx scripts/operational-db.ts backup",
    "db:verify-backup": "node --conditions=react-server --import tsx scripts/operational-db.ts verify-backup",
    "db:restore-empty": "node --conditions=react-server --import tsx scripts/operational-db.ts restore-empty",
    "db:bootstrap-empty": "node --conditions=react-server --import tsx scripts/operational-db.ts bootstrap-empty",
    "db:migrate:mysql": "prisma migrate deploy --config prisma/runtime.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/material-nextjs": "^9.1.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "^7.0.179",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.5",
    "next": "^16.4.6",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.80.0",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "effect": "3.22.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
